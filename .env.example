# Supabase project (Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only: used to write the shared TMDB movie cache. Never expose to the client.
SUPABASE_SECRET_KEY=sb_secret_...

# TMDB (https://www.themoviedb.org/settings/api) - "API Read Access Token"
TMDB_API_READ_TOKEN=

# OMDb (https://www.omdbapi.com/apikey.aspx) - Rotten Tomatoes / Metacritic scores
OMDB_API_KEY=

# Only needed for the local Supabase stack (supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
